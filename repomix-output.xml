        font-size: 0.95rem;
        max-width: 480px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .highlight {
        color: $accent;
    }
}

// ── Main Card ─────────────────────────────────────────────────────────────────
.interview-card {
    width: 100%;
    max-width: 900px;
    background-color: $bg-card;
    border: 1px solid $border-color;
    border-radius: 1rem;
    overflow: hidden;

    &__body {
        display: flex;
        min-height: 520px;
    }

    &__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-top: 1px solid $border-color;

        .footer-info {
            font-size: 0.8rem;
            color: $text-muted;
        }
    }
}

// ── Panels ────────────────────────────────────────────────────────────────────
.panel-divider {
    width: 1px;
    background-color: $border-color;
    flex-shrink: 0;
}

.panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;

    &__header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.25rem;

        h2 {
            font-size: 1rem;
            font-weight: 600;
            color: $text-primary;
            flex: 1;
        }
    }

    &__icon {
        display: flex;
        align-items: center;
        color: $accent;
    }

    &__textarea {
        flex: 1;
        width: 100%;
        background-color: $bg-input;
        border: 1px solid $border-color;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        color: $text-primary;
        font-family: $font-stack;
        font-size: 0.875rem;
        resize: none;
        outline: none;
        transition: border-color 0.2s;
        line-height: 1.5;

        &::placeholder {
            color: $text-muted;
        }

        &:focus {
            border-color: $accent;
        }

        &--short {
            flex: unset;
            height: 96px;
        }
    }

    &--left {
        position: relative;

        .char-counter {
            position: absolute;
            bottom: 2.25rem;
            right: 2rem;
            font-size: 0.75rem;
            color: $text-muted;
        }
    }

    &--right {
        gap: 0.75rem;
    }
}

// ── Badges ────────────────────────────────────────────────────────────────────
.badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;

    &--required {
        background-color: rgba($badge-required, 0.15);
        color: $badge-required;
        border: 1px solid rgba($badge-required, 0.3);
    }

    &--best {
        background-color: rgba($badge-best, 0.15);
        color: $badge-best;
        border: 1px solid rgba($badge-best, 0.3);
    }
}

// ── Section Label ─────────────────────────────────────────────────────────────
.section-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: $text-primary;
    margin-bottom: 0.25rem;
}

// ── Dropzone ──────────────────────────────────────────────────────────────────
.upload-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.5rem 1rem;
    background-color: $bg-input;
    border: 2px dashed $border-color;
    border-radius: 0.6rem;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;

    &:hover {
        border-color: $accent;
        background-color: rgba($accent, 0.05);
    }

    &__icon {
        color: $accent;
        margin-bottom: 0.25rem;
    }

    &__title {
        font-size: 0.875rem;
        font-weight: 500;
        color: $text-primary;
        margin: 0;
    }

    &__subtitle {
        font-size: 0.75rem;
        color: $text-muted;
        margin: 0;
    }
}

// ── OR Divider ────────────────────────────────────────────────────────────────
.or-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: $text-muted;
    font-size: 0.75rem;

    &::before,
    &::after {
        content: '';
        flex: 1;
        height: 1px;
        background-color: $border-color;
    }

    span {
        white-space: nowrap;
    }
}

// ── Self Description ──────────────────────────────────────────────────────────
.self-description {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

// ── Info Box ──────────────────────────────────────────────────────────────────
.info-box {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background-color: $info-bg;
    border: 1px solid $info-border;
    border-radius: 0.5rem;

    &__icon {
        flex-shrink: 0;
        color: #4a90e2;
        margin-top: 1px;
    }

    p {
        margin: 0;
        font-size: 0.8rem;
        color: #8ab4f8;
        line-height: 1.5;

        strong {
            color: $text-primary;
        }
    }
}

// ── Generate Button ───────────────────────────────────────────────────────────
.generate-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, $accent 0%, darken($accent, 10%) 100%);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
    font-family: $font-stack;

    &:hover {
        opacity: 0.9;
    }

    &:active {
        transform: scale(0.98);
    }
}

.recent-reports{
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 900px;

    .reports-list{
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;

        .report-item{
            background-color: $bg-card;
            border: 1px solid $border-color;
            border-radius: 0.5rem;
            padding: 1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            cursor: pointer;
            flex-shrink: 0;

            .match-score {
                font-size: 0.8rem;
                font-weight: 600;
                color: $accent;
                align-items: flex-start;
            }
        }
    }
}


// ── Page Footer ───────────────────────────────────────────────────────────────
.page-footer {
    display: flex;
    gap: 1.5rem;

    a {
        font-size: 0.8rem;
        color: $text-muted;
        text-decoration: none;
        transition: color 0.2s;

        &:hover {
            color: $text-primary;
        }
    }
}
</file>

<file path="frontend/src/features/interview/style/interview.scss">
// ── Shared Variables (mirrors home.scss theme) ────────────────────────────────
@use "sass:color";
$bg-page: #0d1117;
$bg-card: #161b22;
$bg-panel: #1c2230;
$bg-input: #1e2535;
$border-color: #2a3348;
$text-primary: #e6edf3;
$text-muted: #7d8590;
$accent: #ff2d78;
$font-stack: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

// severity palette
$severity-high: #ff4d4d;
$severity-medium: #f5a623;
$severity-low: #3fb950;

*::-webkit-scrollbar {
    display: none;
}

// ── Page Shell ────────────────────────────────────────────────────────────────
.interview-page {
    width: 100%;
    min-height: 100vh;
    background-color: $bg-page;
    color: $text-primary;
    font-family: $font-stack;
    display: flex;
    align-items: stretch;
    padding: 1.5rem;
    box-sizing: border-box;
}

// ── 3-Column Layout ───────────────────────────────────────────────────────────
.interview-layout {
    display: flex;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    background-color: $bg-card;
    border: 1px solid $border-color;
    border-radius: 1rem;
    justify-content: space-between;
}

.interview-divider {
    width: 1px;
    background-color: $border-color;
    flex-shrink: 0;
}

// ── Left Nav ─────────────────────────────────────────────────────────────────
.interview-nav {
    width: 220px;
    flex-shrink: 0;
    padding: 1.75rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;




    &__label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: $text-muted;
        padding: 0 0.75rem;
        margin-bottom: 0.5rem;
    }

    &__item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.65rem 0.75rem;
        background: none;
        border: none;
        border-radius: 0.5rem;
        color: $text-muted;
        font-family: $font-stack;
        font-size: 0.875rem;
        cursor: pointer;
        text-align: left;
        transition: background-color 0.15s, color 0.15s;

        &:hover {
            background-color: $bg-panel;
            color: $text-primary;
        }

        &--active {
            background-color: rgba($accent, 0.1);
            color: $accent;

            .interview-nav__icon svg {
                stroke: $accent;
            }
        }
    }

    &__icon {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
}

// ── Center Content ────────────────────────────────────────────────────────────
.interview-content {
    flex: 1;
    padding: 1.75rem 2rem;
    overflow-y: auto;
    min-height: initial;
    max-height: calc(100vh - 3rem);
    padding-bottom: 5rem;
    align-items: flex-start;








    section {
        min-height: 100%;
    }
}

.content-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid $border-color;

    h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: $text-primary;
        margin: 0;
    }

    &__count {
        font-size: 0.8rem;
        color: $text-muted;
        background-color: $bg-panel;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        border: 1px solid $border-color;
    }
}

// ── Question Cards ────────────────────────────────────────────────────────────
.q-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.q-card {
    background-color: $bg-panel;
    border: 1px solid $border-color;
    border-radius: 0.6rem;
    overflow: hidden;
    transition: border-color 0.2s;

    &:hover {
       border-color: color.adjust($border-color, $lightness: 8%);
    }

    &__header {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.9rem 1rem;
        cursor: pointer;
        user-select: none;
    }

    &__index {
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 700;
        color: $accent;
        background-color: rgba($accent, 0.1);
        border: 1px solid rgba($accent, 0.2);
        border-radius: 0.3rem;
        padding: 0.15rem 0.4rem;
        margin-top: 2px;
    }

    &__question {
        flex: 1;
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        color: $text-primary;
        line-height: 1.5;
    }

    &__chevron {
        flex-shrink: 0;
        color: $text-muted;
        transition: transform 0.2s;
        margin-top: 2px;

        &--open {
            transform: rotate(180deg);
            color: $accent;
        }
    }

    &__body {
        padding: 0 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        border-top: 1px solid $border-color;
        padding-top: 0.75rem;
    }

    &__section {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;

        p {
            margin: 0;
            font-size: 0.835rem;
           color: color.adjust($text-muted, $lightness: 12%);
            line-height: 1.6;
        }
    }

    &__tag {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        width: fit-content;

        &--intention {
            color: #a78bfa;
            background-color: rgba(#a78bfa, 0.1);
            border: 1px solid rgba(#a78bfa, 0.2);
        }

        &--answer {
            color: #3fb950;
            background-color: rgba(#3fb950, 0.1);
            border: 1px solid rgba(#3fb950, 0.2);
        }
    }
}

// ── Road Map ──────────────────────────────────────────────────────────────────
.roadmap-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;

    // vertical timeline line
    &::before {
        content: '';
        position: absolute;
        left: 28px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, $accent, rgba($accent, 0.1));
        border-radius: 1px;
    }
}

.roadmap-day {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0 0.75rem 3.5rem;
    position: relative;

    // dot on timeline
    &::before {
        content: '';
        position: absolute;
        left: 21px;
        top: 1.05rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: $bg-card;
        border: 2px solid $accent;
    }

    &__header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    &__badge {
        font-size: 0.7rem;
        font-weight: 700;
        color: $accent;
        background-color: rgba($accent, 0.1);
        border: 1px solid rgba($accent, 0.25);
        padding: 0.1rem 0.5rem;
        border-radius: 2rem;
    }

    &__focus {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: $text-primary;
    }

    &__tasks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;

        li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            font-size: 0.845rem;
            color: color.adjust($text-muted, $lightness: 12%);
            line-height: 1.5;
        }
    }

    &__bullet {
        flex-shrink: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: $text-muted;
        margin-top: 8px;
    }
}

// ── Right Sidebar ─────────────────────────────────────────────────────────────
.interview-sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.sidebar-divider {
    height: 1px;
    background-color: $border-color;
}

// Match Score
.match-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;

    &__label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: $text-muted;
        margin: 0;
        align-self: flex-start;
    }

    &__ring {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 4px solid;

        &.score--high {
            border-color: $severity-low;
        }

        &.score--mid {
            border-color: $severity-medium;
        }

        &.score--low {
            border-color: $severity-high;
        }
    }

    &__value {
        font-size: 1.6rem;
        font-weight: 800;
        color: $text-primary;
        line-height: 1;
    }

    &__pct {
        font-size: 0.75rem;
        color: $text-muted;
        margin-top: -2px;
    }

    &__sub {
        margin: 0;
        font-size: 0.75rem;
        color: $severity-low;
        text-align: center;
    }
}

// Skill Gaps
.skill-gaps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    &__label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: $text-muted;
        margin: 0;
    }

    &__list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
}

.skill-tag {
    font-size: 0.775rem;
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border-radius: 0.4rem;
    border: 1px solid;
    cursor: default;

    &--high {
        color: $severity-high;
        background-color: rgba($severity-high, 0.1);
        border-color: rgba($severity-high, 0.25);
    }

    &--medium {
        color: $severity-medium;
        background-color: rgba($severity-medium, 0.1);
        border-color: rgba($severity-medium, 0.25);
    }

    &--low {
        color: $severity-low;
        background-color: rgba($severity-low, 0.1);
        border-color: rgba($severity-low, 0.25);
    }
}
</file>

